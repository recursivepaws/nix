{
  den.aspects.music = {
    homeManager =
      { pkgs, config, ... }:
      let
        dj-scrobbler =
          let
            version = "0.6.1";
            src = pkgs.fetchurl {
              url = "https://github.com/ericcastro/dj-scrobbler/releases/download/v${version}/DJ-Scrobbler-${version}.AppImage";
              hash = "sha256-j03yPcUcmaPPvIIY4maXSMfUVbL0qX+eWOJHpPUxXps=";
            };
            contents = pkgs.appimageTools.extract {
              inherit version src;
              pname = "dj-scrobbler";
            };
          in
          pkgs.appimageTools.wrapType2 {
            inherit version src;
            pname = "dj-scrobbler";
            # /etc is a tmpfs inside the FHS sandbox, so launching from a cwd
            # under /etc (e.g. /etc/nixos) fails bwrap's --chdir.
            chdirToPwd = false;
            extraInstallCommands = ''
              install -Dm444 ${contents}/dj-scrobbler.desktop -t $out/share/applications
              substituteInPlace $out/share/applications/dj-scrobbler.desktop --replace-fail 'Exec=AppRun' 'Exec=dj-scrobbler'
              cp -r ${contents}/usr/share/icons $out/share
            '';
          };

        # MPD refuses file:// URIs over TCP, and the playlists below are all file://.
        # Under dataDir so mpd.service's ExecStartPre makes the parent.
        mpdSocket = "${config.services.mpd.dataDir}/socket";

        # One stored playlist per folder in ~/Music/playlists, as absolute file:// URIs.
        # They need no database entry, so the tracks stay out of the library browse.
        mpd-playlists = pkgs.writeShellApplication {
          name = "mpd-playlists";
          runtimeInputs = with pkgs; [
            coreutils
            findutils
            gnugrep
          ];
          text = ''
            src="${config.home.homeDirectory}/Music/playlists"
            dst="${config.services.mpd.playlistDirectory}"
            marker="# generated by mpd-playlists"

            [ -d "$src" ] || exit 0
            mkdir -p "$dst"

            for d in "$src"/*/; do
              [ -d "$d" ] || continue
              {
                printf '#EXTM3U\n%s\n' "$marker"
                # sort -V: track numbers pad to two digits then run past 99.
                # A lexical sort would put 100 before 99.
                find "$d" -maxdepth 1 -type f \
                  \( -iname '*.flac' -o -iname '*.mp3' -o -iname '*.m4a' \
                     -o -iname '*.opus' -o -iname '*.ogg' -o -iname '*.wav' \
                     -o -iname '*.aiff' \) \
                  -printf 'file://%p\n' | sort -V
              } > "$dst/$(basename "$d").m3u"
            done

            # Drop generated playlists whose source folder is gone.
            # Playlists made by hand in rmpc lack the marker, so they survive.
            for f in "$dst"/*.m3u; do
              [ -f "$f" ] || continue
              grep -qxF "$marker" "$f" || continue
              [ -d "$src/$(basename "$f" .m3u)" ] || rm -f "$f"
            done
          '';
        };
      in
      {
        # Euphonica defaults to localhost:6600; the socket also loads the file:// playlists.
        dconf.settings."io/github/htkhiem/Euphonica/client" = {
          mpd-use-unix-socket = true;
          mpd-unix-socket = mpdSocket;
        };

        xdg.configFile."rmpc/config.ron".source =
          pkgs.runCommand "rmpc-config.ron" { }
            "${pkgs.rmpc}/bin/rmpc config > $out";

        home.packages = with pkgs; [
          rmpc
          euphonica
          nicotine-plus
          pavucontrol
          spotiflac
          dj-scrobbler
          mpd-playlists
        ];
        services = {
          mpd = {
            enable = true;
            musicDirectory = "${config.home.homeDirectory}/Music/beets";
            # Also exports MPD_HOST, which is how rmpc ends up on the socket.
            network.listenAddress = mpdSocket;
            # No TCP: every user on a host gets this aspect, and two mpds can't share 127.0.0.1:6600.
            # The loser's mpdscribble then scrobbles the other user's plays.
            extraConfig = ''
              audio_output {
                type    "pipewire"
                name    "pipewire"
              }
              auto_update "no"
              replaygain "auto"
              zeroconf_enabled "no"
            '';
          };

          mpd-mpris = {
            enable = true;
            settings = {
              network = "unix";
              host = mpdSocket;
            };
          };
          mpdscribble = {
            enable = true;
            verbose = 3;
            host = mpdSocket;
            endpoints = {
              "last.fm" = {
                passwordFile = "/run/agenix/lastfm";
                username = "recursivepaws";
              };
              # "listenbrainz" = {
              #   passwordFile = "/run/secrets/listenbrainz";
              #   username = "recursivepaws";
              # };
            };
          };
        };

        # A .path unit can't cover this: a new track bumps the subfolder's mtime.
        # Watching ~/Music/playlists only fires when a folder appears or disappears.
        systemd.user = {
          # Both modules only order after mpd for a TCP localhost host.
          services.mpd-mpris.Unit.After = [ "mpd.service" ];
          services.mpdscribble.Unit.After = [ "mpd.service" ];
          services.mpd-playlists = {
            Unit.Description = "Generate MPD stored playlists from ~/Music/playlists";
            Service = {
              Type = "oneshot";
              ExecStart = "${mpd-playlists}/bin/mpd-playlists";
            };
          };
          timers.mpd-playlists = {
            Unit.Description = "Regenerate MPD stored playlists";
            Timer = {
              OnStartupSec = "1m";
              OnUnitActiveSec = "15m";
            };
            Install.WantedBy = [ "timers.target" ];
          };
        };
      };
  };
}
