     }
+    Process {
+        id: annotateFileProc
+        stdout: StdioCollector {}
+        onExited: (code) => {
+            root.isRunning = false
+            var screen = annotateRegionState._pendingScreen
+            annotateRegionState._pendingScreen = null
+            if (code !== 0) {
+                ToastService.showError(pluginApi.tr("messages.capture-failed"))
+                return
+            }
+            var dims = annotateFileProc.stdout.text.trim().split("x")
+            var w = parseInt(dims[0]) || 0
+            var h = parseInt(dims[1]) || 0
+            if (w <= 0 || h <= 0) return
+            var sw = screen ? screen.width  : w
+            var sh = screen ? screen.height : h
+            var x = Math.max(0, Math.round((sw - w) / 2))
+            var y = Math.max(0, Math.round((sh - h) / 2))
+            annotateOverlay.parseAndShow(x + "," + y + " " + w + "x" + h, "/tmp/screen-toolkit-annotate.png", screen)
+        }
+    }
     QtObject {
         id: annotateRegionState
         property string _pendingRegion: ""
@@ -609,6 +631,25 @@
             launchAnnotateActiveWindow.start()
         })
     }
+    function runAnnotateFile(path) {
+        if (root.isRunning || !path || path === "") return
+        root.isRunning = true
+        var launch = function(screen) {
+            annotateRegionState._pendingScreen = screen
+            annotateFileProc.exec({ command: ["bash", "-c",
+                "cp -f " + U.shellEscape(path) + " /tmp/screen-toolkit-annotate.png && " +
+                "magick identify -format %wx%h /tmp/screen-toolkit-annotate.png"
+            ]})
+        }
+        if (pluginApi) {
+            pluginApi.withCurrentScreen(screen => {
+                pluginApi.closePanel(screen)
+                launch(screen)
+            })
+        } else {
+            launch(null)
+        }
+    }
